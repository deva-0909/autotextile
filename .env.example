# Copy to .env and adjust. All services read this file.
# PostgreSQL connection (one database; every service owns its own schema).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/textile_erp

# Secret used to sign access tokens. Change for any shared environment.
JWT_SECRET=change-me-to-a-long-random-string

# Ports (gateway is the only one you open in the browser).
GATEWAY_PORT=4000
IDENTITY_PORT=4101
ORGANISATION_PORT=4102
MASTERS_PORT=4103
GOVERNANCE_PORT=4104
PROCUREMENT_PORT=4105
JOBWORK_PORT=4106
INVENTORY_PORT=4107
CRM_PORT=4108
COMMERCE_PORT=4109
FULFILMENT_PORT=4110
FINANCE_PORT=4111
WORKFLOW_PORT=4112
HRMS_PORT=4113

# Optional: enables AI invoice extraction (Claude). Without it, invoices are keyed in on the review screen.
ANTHROPIC_API_KEY=
# Invoices extracted in parallel by the capture worker.
EXTRACTION_CONCURRENCY=4

# Where uploaded documents are stored (S3-compatible storage later).
STORAGE_DIR=./storage

# Payment gateway: 'sandbox' simulates the bank so the whole flow works locally.
# Switch to 'icici' once ICICI Bank issues merchant credentials (adapter in services/commerce/src/gateway.ts).
PAYMENT_GATEWAY=sandbox
PAYMENT_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Customer messages (WhatsApp, SMS, email). "sandbox" records and delivers them inside the ERP only.
# "live" sends WhatsApp through the Meta Cloud API (WHATSAPP_TOKEN, WHATSAPP_PHONE_NUMBER_ID); SMS and email adapters still need a provider.
MESSAGING_PROVIDER=sandbox
MESSAGING_WEBHOOK_SECRET=change-me
# Public address used in links sent to customers (payment, tracking, invoices).
APP_PUBLIC_URL=http://localhost:4000
