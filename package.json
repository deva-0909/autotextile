{
  "name": "textile-erp",
  "private": true,
  "version": "0.1.0",
  "description": "Textile Trading ERP — domain microservices (identity, organisation, masters, governance) behind an API gateway, with a React ERP web app.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "setup": "node scripts/setup.ts",
    "backup": "node scripts/backup.ts",
    "load-test": "node scripts/load-test.ts",
    "start": "node scripts/run.ts",
    "dev": "node scripts/run.ts --watch",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck -w apps/web"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.2"
  }
}
